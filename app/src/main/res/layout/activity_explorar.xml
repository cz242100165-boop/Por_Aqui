<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="‹  Explorar negocios"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:layout_marginTop="15dp">

        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="🔎 ¿Qué estás buscando?"
            android:background="@drawable/bg_search"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnBuscar"
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:text="Buscar"/>

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <Button
                android:id="@+id/btnTodos"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Todos"/>

            <Button
                android:id="@+id/btnComida"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="🍔 Comida"/>

            <Button
                android:id="@+id/btnCafeterias"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="☕ Cafeterías"/>

            <Button
                android:id="@+id/btnBelleza"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="💇 Belleza"/>

            <Button
                android:id="@+id/btnTiendas"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="🛒 Tiendas"/>

        </LinearLayout>

    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Negocios encontrados"
        android:textSize="15sp"
        android:textColor="@color/gray"
        android:padding="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNegocios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>