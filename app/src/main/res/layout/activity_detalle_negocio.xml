<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:text="‹"/>

        <TextView
            android:id="@+id/tvIcono"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:text="🍔"
            android:textSize="65sp"
            android:gravity="center"
            android:background="@color/orange"/>

        <TextView
            android:id="@+id/tvCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COMIDA"
            android:textColor="@color/green_primary"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pupusería Doña Marta"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⭐ 4.8   (42 reseñas)"
            android:textSize="15sp"
            android:textColor="@color/gray"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 1.2 km · Colonia El Ángel"
            android:textSize="15sp"
            android:textColor="@color/gray"
            android:paddingBottom="15dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="◷\nAbierto ahora\n7:00 AM - 7:00 PM"
                android:gravity="center"
                android:background="@drawable/bg_card"/>

            <TextView
                android:id="@+id/tvTelefono"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="📞\nContactar\n7XXX-1234"
                android:gravity="center"
                android:background="@drawable/bg_card"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sobre este negocio"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pupusas recién hechas, platos típicos y sabor casero para toda la familia."
            android:textSize="15sp"
            android:textColor="@color/gray"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Productos destacados"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Café americano                         $1.50"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Pan con pollo                           $2.50"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Desayuno típico                         $4.00"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnMapa"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📍 Ver ubicación en el mapa"
            android:layout_marginTop="18dp"/>

    </LinearLayout>

</ScrollView>