<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mi perfil"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"/>

    <TextView
        android:layout_width="95dp"
        android:layout_height="95dp"
        android:layout_gravity="center"
        android:layout_marginTop="25dp"
        android:gravity="center"
        android:text="S"
        android:textSize="38sp"
        android:textColor="@color/white"
        android:background="@drawable/bg_avatar"/>

    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sofía Martínez"
        android:textSize="25sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="15dp"
        android:textColor="@color/text_dark"/>

    <TextView
        android:id="@+id/tvCorreo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="sofia@email.com · Sonsonate"
        android:textSize="15sp"
        android:gravity="center"
        android:textColor="@color/gray"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/tvGuardados"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="12\nGuardados"
            android:gravity="center"
            android:background="@drawable/bg_card"/>

        <TextView
            android:id="@+id/tvResenas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="4\nReseñas"
            android:gravity="center"
            android:background="@drawable/bg_card"/>

        <TextView
            android:id="@+id/tvVisitas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="8\nVisitas"
            android:gravity="center"
            android:background="@drawable/bg_card"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mi cuenta"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_marginTop="25dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="💗  Negocios guardados                         ›"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="◷  Historial de visitas                         ›"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="🔔  Notificaciones                              ›"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="⚙️  Configuración                               ›"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="12dp"/>

</LinearLayout>